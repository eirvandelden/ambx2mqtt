#!/usr/bin/env ruby

require "bundler/setup"
require "optparse"
require "libambx"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "ambx2mqtt"

configuration_path = nil

OptionParser.new do |options|
  options.banner = "Usage: ambx2mqtt --config PATH"
  options.on("-c", "--config PATH", "the configuration file to read") { |path| configuration_path = path }
end.parse!

abort("ambx2mqtt needs a configuration file: ambx2mqtt --config PATH") unless configuration_path

begin
  configuration = Ambx2mqtt::Configuration.read(configuration_path)
  Ambx2mqtt.logger.level = configuration.log_level

  Ambx2mqtt::Installation.new(configuration, controllers: Ambx).daemon.run
rescue Errno::ENOENT
  abort("ambx2mqtt cannot find a configuration file at #{configuration_path}")
rescue Ambx2mqtt::CannotReadSecret => error
  abort("#{error.message}. Unlock 1Password and try again.")
rescue Interrupt
  Ambx2mqtt.logger.info("stopping")
end
